{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEMANTIC GPT-5.6 Sol High provisional judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "provisional_label",
    "error_types",
    "confidence",
    "reason",
    "evidence_reference"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "provisional_label": {
      "enum": [
        "AMBIGUOUS",
        "SUPPORTED",
        "UNSUPPORTED"
      ]
    },
    "error_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "attribution",
          "causality",
          "chronology",
          "contradiction",
          "none",
          "other",
          "overclaim",
          "unsupported_relation",
          "wrong_event_link"
        ]
      }
    },
    "confidence": {
      "enum": [
        "high",
        "low",
        "medium"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "evidence_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provisional_label": {
            "enum": [
              "SUPPORTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error_types": {
            "const": [
              "none"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provisional_label": {
            "not": {
              "enum": [
                "SUPPORTED"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "error_types": {
            "not": {
              "contains": {
                "const": "none"
              }
            }
          }
        }
      }
    }
  ]
}
