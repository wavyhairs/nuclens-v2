# 로컬 실행용 비밀값 템플릿.
#
#   cp .env.example .env      (Windows PowerShell: copy .env.example .env)
#
# 채운 .env 는 .gitignore 대상이라 커밋되지 않는다. 값에 따옴표를 두르지 말 것 —
# 파서가 `키=값` 을 그대로 읽어 따옴표까지 값에 들어간다.
# GitHub Actions 에서는 이 파일 대신 Repository Secrets 를 쓴다.

# ── 수집 (crawl) ──────────────────────────────────────────────────────────────
# NAVER API HUB(네이버 클라우드 플랫폼) → 콘솔 → NAVER API HUB → 검색
#   https://www.ncloud.com/product/applicationService/naverApiHub
# developers.naver.com 이 아니다 — 2026-06-25 이관됐고 구 창구의 키는
# openapi.naver.com 과 함께 401 로 죽는다. 자격증명 자체는 그대로 넘어온다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 발송 (daily-brief / weekly) ───────────────────────────────────────────────
# @BotFather 로 봇 생성 → 토큰. CHAT_ID 는 봇에게 아무 말이나 보낸 뒤
# https://api.telegram.org/bot<토큰>/getUpdates 의 result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 구독자용 채널 (선택). 비워 두면 채널 공개만 건너뛰고 나머지는 그대로 돈다 —
# CHAT_ID 로 폴백하지 않는다. 공개 채널은 @이름, 비공개 채널은 -100… 숫자 ID.
# 봇을 채널 '관리자'로 초대하고 메시지 게시 권한을 켠 뒤:
#   python channel_queue.py --check-channel   (메시지를 보내지 않고 확인만)
TELEGRAM_CHANNEL_ID=

# ── 큐레이션·투자관점·오디오 (선택) ────────────────────────────────────────────
# https://aistudio.google.com/apikey
# 없으면 큐레이션·투자관점이 폴백으로 내려가고 오디오 브리핑은 생성되지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── ANS 뉴스레터 수집 (선택) ──────────────────────────────────────────────────
# Gmail 앱 비밀번호. 공백은 모두 제거하고 넣을 것.
IMAP_USER=
IMAP_PASSWORD=
